{
  "name": "riego-inteligente",
  "version": "1.0.0",
  "private": true,
  "description": "Riego inteligente de césped (ET0 FAO-56 + Open-Meteo) para Android",
  "scripts": {
    "start": "ng serve",
    "build": "npm run build:runner && ng build",
    "build:runner": "esbuild runner/background.ts --bundle --format=iife --target=es2019 --outfile=runner/dist/background.js",
    "test": "esbuild test/*.test.mjs --bundle --platform=node --format=esm --outdir=.test-dist --out-extension:.js=.mjs --log-level=warning && node --test \".test-dist/*.test.mjs\"",
    "e2e": "npm run build && node --test e2e/*.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "cap:sync": "npm run build && cap sync android",
    "apk:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@ionic/angular": "^8.7.0",
    "ionicons": "^8.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@capacitor/cli": "^8.0.0",
    "angular-eslint": "^20.7.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.56.1",
    "prettier": "^3.9.10",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.72.2"
  }
}
