{
  "name": "riego-inteligente",
  "version": "1.0.0",
  "private": true,
  "description": "Riego inteligente de césped (ET0 FAO-56 + Open-Meteo) para Android",
  "scripts": {
    "start": "ng serve",
    "build": "npm run build:runner && ng build",
    "build:runner": "esbuild runner/background.ts --bundle --format=iife --target=es2019 --outfile=runner/dist/background.js",
    "test": "esbuild test/*.test.mjs --bundle --platform=node --format=esm --outdir=.test-dist --out-extension:.js=.mjs --log-level=warning && node --test \".test-dist/*.test.mjs\"",
    "cap:sync": "npm run build && cap sync android",
    "apk:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@ionic/angular": "^8.7.0",
    "ionicons": "^8.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.0"
  }
}
